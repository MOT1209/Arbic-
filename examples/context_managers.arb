# Context managers: كائن بيفتح نفسه ويقفلها مهما حصل

صنف ملف
    دالة __تهيئة__ (اسم)
        انا.اسم = اسم
        انا.مفتوح = غلط
    خلاص

    دالة __دخول__ ()
        انا.مفتوح = صح
        اطبع "فتح " زائد انا.اسم
        رجّع انا
    خلاص

    دالة __خروج__ ()
        انا.مفتوح = غلط
        اطبع "قفل " زائد انا.اسم
    خلاص
خلاص

استخدم ملف("بيانات") باسم م
    اطبع م.مفتوح
خلاص

حاول
    استخدم ملف("مؤقت") باسم م
        ارم "خطأ"
    خلاص
امسك خطأ
    اطبع "اتمسك"
خلاص
