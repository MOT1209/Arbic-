دالة فيب (ن)
    لو ن أصغر من 2
        رجّع ن
    خلاص
    رجّع فيب(ن ناقص 1) زائد فيب(ن ناقص 2)
خلاص

اطبع "فيب(25) = " زائد فيب(25)

خلي مجموع = 0
خلي عداد = 0
طالما عداد أصغر من 100000
    مجموع = مجموع زائد عداد
    عداد = عداد زائد 1
خلاص
اطبع "المجموع = " زائد مجموع
