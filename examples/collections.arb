# القوائم والقواميس والتكرار

# قائمة
خلي الفواكه = ["تفاح"، "موز"، "عنب"]
اطبع "عدد الفواكه: " + طول(الفواكه)
اطبع "الأولى: " + الفواكه[0]

# إضافة وتعديل
اضف(الفواكه، "برتقال")
الفواكه[1] = "مانجو"
اطبع الفواكه

# المرور على القائمة
لكل فاكهة في الفواكه
    اطبع "- " + فاكهة
خلاص

# قاموس
خلي طالب = {"الاسم": "سارة"، "الدرجة": 95}
اطبع طالب["الاسم"] + ": " + طالب["الدرجة"]
طالب["ناجح"] = صح

# دوال المكتبة على القوائم
خلي أرقام = [5، 3، 8، 1]
اطبع "المجموع: " + مجموع(أرقام)
اطبع "الأكبر: " + اكبر(أرقام)
اطبع "مرتبة: " + رتب(أرقام)
اطبع "مدى: " + مدى(1، 6)

# نصوص
اطبع قسّم("أ,ب,ج"، ",")
اطبع ادمج(["واحد"، "اثنان"]، " و ")
