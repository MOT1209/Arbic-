# الأصناف: خصائص وطرق وطرق ساكنة ووراثة مفردة وتغليف وواجهة

واجهة قابل_للتعريف
    دالة عرّف_نفسك() : نص
خلاص

صنف شخص ينفذ قابل_للتعريف
    خاص التصنيف

    دالة __تهيئة__(الاسم، السن)
        انا.الاسم = الاسم
        انا.السن = السن
        انا.التصنيف = "إنسان"
    خلاص

    خاص دالة لقب()
        رجّع "مهندس"
    خلاص

    دالة عرّف_نفسك() : نص
        رجّع "أنا " + انا.الاسم + " وعندي " + انا.السن + " سنة (" + انا.لقب() + ")"
    خلاص

    دالة ساكنة نوع_الكائن()
        رجّع "إنسان"
    خلاص
خلاص

صنف طالب يرث شخص ينفذ قابل_للتعريف
    دالة __تهيئة__(الاسم، السن، المدرسة)
        الأساس.__تهيئة__(الاسم، السن)
        انا.المدرسة = المدرسة
    خلاص

    دالة عرّف_نفسك() : نص
        رجّع الأساس.عرّف_نفسك() + " وبدرس في " + انا.المدرسة
    خلاص
خلاص

خلي أحمد = شخص("أحمد"، 30)
اطبع أحمد.الاسم
اطبع أحمد.عرّف_نفسك()
اطبع شخص.نوع_الكائن()

أحمد.السن = 31
اطبع أحمد.عرّف_نفسك()

خلي مريم = طالب("مريم"، 20، "جامعة القاهرة")
اطبع مريم.الاسم
اطبع مريم.المدرسة
اطبع مريم.عرّف_نفسك()
اطبع طالب.نوع_الكائن()
