# معالجة الأخطاء: حاول / امسك / أخيرا / ارم

# إمساك خطأ تشغيل
حاول
    خلي نتيجة = 10 على 0
امسك خطأ
    اطبع "حصل خطأ: " + خطأ["الرسالة"]
    اطبع "كود الخطأ: " + خطأ["الكود"]
خلاص

# رمي خطأ من عندك والتعامل معاه
دالة اقسم (أ، ب)
    لو ب يساوي 0
        ارم "القسمة على صفر ممنوعة"
    خلاص
    رجّع أ على ب
خلاص

حاول
    اطبع اقسم(20، 4)
    اطبع اقسم(5، 0)
امسك رسالة
    اطبع "تم إيقاف العملية: " + رسالة
خلاص

# أخيرا بتشتغل دايمًا (للتنظيف)
دالة اقرأ_ملف (اسم)
    حاول
        لو اسم يساوي ""
            ارم "اسم الملف فاضي"
        خلاص
        اطبع "بقرأ: " + اسم
        رجّع صح
    أخيرا
        اطبع "قفلت المورد"
    خلاص
خلاص

اقرأ_ملف("بيانات.txt")
حاول
    اقرأ_ملف("")
امسك e
    اطبع "فشل: " + e
خلاص
