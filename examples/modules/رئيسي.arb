# استيراد وحدة واستعمالها
# شغّل من هنا:  arabic run examples/modules/رئيسي.arb

استورد "رياضيات"

اطبع "٢ + ٣ = " + جمع(2، 3)
اطبع "٤ × ٥ = " + ضرب(4، 5)
اطبع "مربع ٧ = " + مربع(7)
اطبع "باي = " + باي

# أو بالاسم المستعار (namespace)
استورد "رياضيات" باسم ر
اطبع "عن طريق الاسم المستعار: " + ر["جمع"](10، 20)

# أو استيراد انتقائي
من "رياضيات" استورد مربع
اطبع "مربع ٩ = " + مربع(9)
