# أنواع كاملة: قائمة[T]، قاموس[K، V]، اختياري[T]، واتحاد الأنواع
دالة مجموع_الدرجات (درجات : قائمة[رقم]) : رقم
    خلي مجموع : رقم = 0
    لكل درجة في درجات
        مجموع = مجموع زائد درجة
    خلاص
    رجّع مجموع
خلاص

دالة وصف_طالب (اسم : نص، سن : اختياري[رقم]) : نص
    طابق سن
        حالة فراغ
            رجّع اسم
        حالة قيمة
            رجّع اسم زائد " (" زائد نص(قيمة) زائد ")"
    خلاص
    رجّع اسم
خلاص

خلي درجات : قائمة[رقم] = [10، 9، 8]
خلي غياب : قاموس[نص، رقم] = {"أحمد": 0}
اطبع مجموع_الدرجات(درجات)
اطبع وصف_طالب("سارة"، فراغ)
اطبع وصف_طالب("علي"، 20)
