# (التعليقات دي اختيارية؛ البرنامج بيشتغل عادي بـ arabic run)

# متغيّرات بأنواع معلنة
خلي العمر : رقم = 30
خلي الاسم : نص = "أحمد"
خلي مفعّل : منطقي = صح

# دالة بمدخلات ونوع إرجاع معلنين
دالة اجمع (أ : رقم، ب : رقم) : رقم
    رجّع أ زائد ب
خلاص

اطبع اجمع(العمر، 5)

# دالة بترجّع نص
دالة حيّة (اسم : نص) : نص
    رجّع "أهلا يا " زائد اسم
خلاص

اطبع حيّة(الاسم)

# اللي من غير تعليق نوعي = "أي" (gradual) فبيعدّي من غير فحص صارم
دالة مرن (س)
    رجّع س
خلاص

اطبع مرن(123)
اطبع مرن("أي حاجة")
