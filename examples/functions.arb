# الدوال والمكتبة المدمجة

# دالة بسيطة بترجّع قيمة
دالة اجمع (أ، ب)
    رجّع أ زائد ب
خلاص

اطبع "٢ + ٣ = " + اجمع(2، 3)

# دالة تكرارية (recursion)
دالة مضروب (ن)
    لو ن أصغر أو يساوي 1
        رجّع 1
    خلاص
    رجّع ن في مضروب(ن ناقص 1)
خلاص

اطبع "مضروب ٥ = " + مضروب(5)

# دالة بتطبع بس (من غير رجّع) — بترجّع "فراغ"
دالة حيّي (اسم)
    اطبع "أهلا يا " + اسم
خلاص

حيّي("أحمد")
حيّي("سارة")

# دوال مدمجة
اطبع "طول الكلمة: " + طول("برمجة")
اطبع "النوع: " + نوع(123)
اطبع "تحويل نص لرقم: " + (رقم("40") زائد 2)
اطبع "القيمة المطلقة: " + مطلق(-9)

# التحكم في الحلقات: اكسر / كمل
خلي ع = 0
طالما ع أصغر من 10
    ع = ع زائد 1
    لو ع يساوي 5
        اكسر
    خلاص
    اطبع "العدّاد: " + ع
خلاص
