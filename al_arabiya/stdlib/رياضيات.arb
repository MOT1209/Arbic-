# وحدة الرياضيات القياسية — تُستورد بـ: استورد "رياضيات"

# قوة لأس صحيح غير سالب (قوة(2، 10) => 1024)
دالة قوة (أساس، أس)
    خلي ناتج = 1
    خلي ع = 0
    طالما ع أصغر من أس
        ناتج = ناتج في أساس
        ع = ع + 1
    خلاص
    رجّع ناتج
خلاص

# هل العدد زوجي؟
دالة زوجي (عدد)
    رجّع عدد % 2 يساوي 0
خلاص
