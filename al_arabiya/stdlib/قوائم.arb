# وحدة القوائم القياسية — تُستورد بـ: استورد "قوائم"

# مجموع عناصر قائمة أرقام
دالة مجموع (ق)
    خلي ناتج = 0
    لكل عنصر في ق
        ناتج = ناتج + عنصر
    خلاص
    رجّع ناتج
خلاص

# أكبر عنصر في قائمة غير فارغة
دالة الأكبر (ق)
    خلي ناتج = ق[0]
    لكل عنصر في ق
        لو عنصر أكبر من ناتج
            ناتج = عنصر
        خلاص
    خلاص
    رجّع ناتج
خلاص
