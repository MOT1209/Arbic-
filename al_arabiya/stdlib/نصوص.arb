# وحدة النصوص القياسية — تُستورد بـ: استورد "نصوص"

# بترجّع النص مكررًا عدد مرات (مكرر("ها"، 3) => "هاهاها")
دالة مكرر (نص، عدد)
    خلي ناتج = ""
    خلي ع = 0
    طالما ع أصغر من عدد
        ناتج = ناتج + نص
        ع = ع + 1
    خلاص
    رجّع ناتج
خلاص

# بترجّع النص بين علامتي تنصيص، مفيد في الرسائل
دالة مقتبس (نص)
    رجّع "\"" + نص + "\""
خلاص
